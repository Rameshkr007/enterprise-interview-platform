# Application
APP_NAME=Enterprise Interview Platform
ENV=development
DEBUG=true
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# Security — CHANGE IN PRODUCTION
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_BUCKET_NAME=interview-platform
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_SILENCE_THRESHOLD_DB=-40.0
AUDIO_MIN_SILENCE_DURATION_MS=500

# Interview Engine
MAX_QUESTIONS_PER_SESSION=20
DIFFICULTY_UPGRADE_THRESHOLD=0.70
DIFFICULTY_DOWNGRADE_THRESHOLD=0.40

# Logging
LOG_LEVEL=INFO
