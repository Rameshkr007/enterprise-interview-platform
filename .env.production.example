# ==============================================================================
# Enterprise AI Mock Interview & Semantic ATS Platform
# Production Environment Variable Template
# ==============================================================================

# Core Application Settings
ENV=production
DEBUG=false
APP_NAME="Enterprise AI Mock Interview Platform"
APP_VERSION=2.0.0
API_PREFIX=/api/v1
DOMAIN_NAME=interview.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_production_pg_password
POSTGRES_DB=interview_platform
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_strong_production_pg_password@postgres:5432/interview_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Sliding-Window Rate Limiting
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# JWT Security & Auth
SECRET_KEY=replace_with_openssl_rand_hex_64_character_production_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI Integrations
OPENAI_API_KEY=sk-proj-replace_with_your_production_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_REQUEST_TIMEOUT=45.0

# Storage (AWS S3 or Compatible MinIO)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=enterprise-interview-assets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_s3_access_key
AWS_SECRET_ACCESS_KEY=replace_with_s3_secret_key

# Observability & Logging
LOG_LEVEL=INFO
CORS_ORIGINS=["https://interview.yourdomain.com"]
